# Copy to .env on officepi and fill in. Never commit the real file.
#
# ONE .env is shared by every collector in this repo. That is why the settings
# below are grouped: the InfluxDB SERVER is shared, and everything a collector
# owns is prefixed with that collector's name. An unprefixed ECOWITT setting
# would silently reconfigure the Aranet4 job running alongside it.
#
# The InfluxDB token is the only secret here. It is an InfluxDB API token, not a
# 1Password-rendered value -- this repo predates the render-secrets pattern used
# by observethis/paperless/nut. See README.md "Secrets".

# --- Shared: the InfluxDB server ---------------------------------------------
INFLUX_URL=http://docker20.dbmob.nl:8086
INFLUXDB_TOKEN=replace-with-influxdb-api-token
INFLUX_ORG=homelab

# --- Aranet4 (office desk, over Bluetooth) -----------------------------------
# NOTE: the bucket is per-collector, NOT shared. Both jobs read this file, so a
# single INFLUX_BUCKET would put soil readings in with a year of CO2 history.
INFLUX_BUCKET=aranet4
ARANET_MAC=XX:XX:XX:XX:XX:XX
DEVICE_NAME=aranet4_0B201
LOCATION=office

# --- Ecowitt GW1200B (soil probes, over HTTP) --------------------------------
# The gateway sits on the Arlo (untrusted IoT) VLAN. officepi can reach it;
# it cannot reach officepi. That is why this is a poller.
ECOWITT_GATEWAY_URL=http://10.20.10.156
ECOWITT_INFLUX_BUCKET=sensors
ECOWITT_LOCATION="houseplants"

# Which probes to expect, and what to call them. This one setting is also what
# makes a DEAD probe visible: a channel listed here that stops reporting
# publishes ecowitt_channel_reporting=0 and alerts. Drop a channel from this
# list and its plant silently stops being watched.
#   ECOWITT_CHANNELS="1,2"                      # names optional
#   ECOWITT_CHANNELS="1:Big Plant,2:Little Plant"
#
# QUOTE any value containing a SPACE. python-dotenv parses an unquoted space
# fine, so the collector works either way -- but this file is also `source`d by
# shell one-liners (see docs/QUERYING.md), and bash reads an unquoted
# `1:Big Plant,2:Little Plant` as a command to run:
#     .env: line 16: Plant,2:Little: command not found
# Harmless-looking, and it means any script sourcing this file is running
# garbage before it gets to the query it came for.
ECOWITT_CHANNELS="1:Big Plant,2:Little Plant"

#ECOWITT_DEVICE_NAME=ecowitt-gw1200b
#ECOWITT_LOG_PATH=<repo>/ecowitt_logger.log
#ECOWITT_TIMEOUT_SECONDS=10

# --- Optional, shared by every collector (defaults shown) ---------------------
# Where jobs publish Prometheus metrics. Set to a writable path on a dev box, or
# leave unset in production. If the directory does not exist the job simply
# skips publishing -- instrumentation never breaks collection.
#TEXTFILE_COLLECTOR_DIR=/var/lib/node_exporter/textfile_collector

#LOG_PATH=<repo>/aranet_logger.log
#LOG_TIMEZONE=America/Los_Angeles
#MAX_RETRIES=3
#RETRY_DELAY_SECONDS=5
